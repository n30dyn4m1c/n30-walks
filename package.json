{
  "name": "n30-walks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Stride — a personal, social-free walking tracker with 3D flyovers and WhatsApp Status exports.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs",
    "mobile:android": "node scripts/mobile.mjs android",
    "mobile:ios": "node scripts/mobile.mjs ios"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "maplibre-gl": "^5.24.1",
    "mp4-muxer": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
